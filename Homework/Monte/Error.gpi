set terminal svg background rgb "white"
set output "Error.svg"
set xlabel "error"
set ylabel "y"
set title "unit circle"
set key right top
set logscale xy
set tics in
plot \
        "Error.dat" using 1:2 with lines title "estimated error"\
        ,"Error.dat" using 1:3 with lines title "actual error"\
        ,"Error.dat" using 1:4 with lines title "1/sqrt(N)"\
        ,"ErrorB.dat" using 1:2 with lines title "actual error (quasi)"\