set terminal svg background rgb "white"
set output "quadratic.svg"
set xlabel "x"
set ylabel "y"
set title "Quadratic"
set key right top
set tics in
plot \
"quadratic.dat" using 1:2 with lines title "Quadratic spline", \
"quadratic.dat" using 1:3 with lines title "cos(x)", \
"quadratic.dat" using 1:4 with lines title "Spline derivative", \
"quadratic.dat" using 1:5 with lines title "-sin(x)", \
"quadratic.dat" using 1:6 with lines title "Spline integral", \
"quadratic.dat" using 1:7 with lines title "sin(x)" 